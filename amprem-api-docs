{
  "name": "Alight Motion Premium API (v2 - noxxyrorr)",
  "description": "API untuk mengaktifkan akun Alight Motion Premium lewat magic link email. Alur: kirim magic link ke email (dapat cookie), lalu verifikasi dengan link 'Sign in to Alight Creative' dari email tersebut.",
  "version": "2.0.0",
  "baseUrl": "https://am.noxxyrorr.biz.id/api",
  "authentication": {
    "type": "None (Origin/Referer based)",
    "note": "Tidak memakai API key. Server memvalidasi lewat header Origin & Referer yang harus mengarah ke domain resmi. Kirim Content-Type: application/json.",
    "headers": {
      "Content-Type": "application/json",
      "Origin": "https://am.noxxyrorr.biz.id",
      "Referer": "https://am.noxxyrorr.biz.id/"
    }
  },
  "conventions": {
    "method": "POST",
    "encoding": "Body dikirim sebagai JSON (application/json). Tidak perlu URL-encode manual; cukup kirim nilai asli di body.",
    "responseFormat": "JSON"
  },
  "flow": [
    {
      "step": 1,
      "action": "POST /send-link",
      "detail": "Kirim magic link Alight Creative ke email yang akan dijadikan premium. Simpan nilai `cookie` dari respons — dipakai di step berikutnya."
    },
    {
      "step": 2,
      "action": "Buka inbox email",
      "detail": "Cari email berjudul 'Sign in to Alight Creative'. Abaikan email 'Login to Alight Creative'."
    },
    {
      "step": 3,
      "action": "Salin link dari email",
      "detail": "Link ada di balik teks 'Sign in to Alight Creative' (bentuknya tautan, bukan teks biasa)."
    },
    {
      "step": 4,
      "action": "POST /verify-link",
      "detail": "Kirim email + cookie (dari step 1) + magicLink (dari email) + customOrderId untuk mengaktifkan premium."
    }
  ],
  "endpoints": [
    {
      "name": "Kirim magic link",
      "method": "POST",
      "path": "/send-link",
      "url": "https://am.noxxyrorr.biz.id/api/send-link",
      "description": "Mengirim email berisi magic link Alight Creative ke alamat yang diberikan. Respons biasanya menyertakan `cookie` yang wajib dipakai di /verify-link.",
      "headers": {
        "Content-Type": "application/json",
        "Origin": "https://am.noxxyrorr.biz.id",
        "Referer": "https://am.noxxyrorr.biz.id/"
      },
      "body": {
        "email": {
          "type": "string",
          "required": true,
          "description": "Alamat email tujuan.",
          "example": "akunwarnet62@gmail.com"
        }
      },
      "example": {
        "curl": "curl -X POST \"https://am.noxxyrorr.biz.id/api/send-link\" -H \"Content-Type: application/json\" -H \"Origin: https://am.noxxyrorr.biz.id\" -H \"Referer: https://am.noxxyrorr.biz.id/\" -d '{\"email\":\"akunwarnet62@gmail.com\"}'",
        "response": {
          "note": "CONTOH PERKIRAAN — format asli belum terverifikasi. Simpan field `cookie`.",
          "ok": true,
          "email": "akunwarnet62@gmail.com",
          "cookie": "SESSION=xxxxx; Path=/; ...",
          "message": "Link verifikasi telah dikirim."
        }
      }
    },
    {
      "name": "Verifikasi & aktivasi premium",
      "method": "POST",
      "path": "/verify-link",
      "url": "https://am.noxxyrorr.biz.id/api/verify-link",
      "description": "Memverifikasi magic link lalu mengaktifkan Alight Motion Premium pada email tersebut. Wajib menyertakan cookie dari step /send-link.",
      "headers": {
        "Content-Type": "application/json",
        "Origin": "https://am.noxxyrorr.biz.id",
        "Referer": "https://am.noxxyrorr.biz.id/"
      },
      "body": {
        "email": {
          "type": "string",
          "required": true,
          "description": "Email yang sama dengan yang dipakai pada /send-link."
        },
        "cookie": {
          "type": "string",
          "required": true,
          "description": "Nilai cookie dari respons /send-link (session untuk proses verifikasi)."
        },
        "magicLink": {
          "type": "string",
          "required": true,
          "description": "Link dari email 'Sign in to Alight Creative' (bukan 'Login to Alight Creative'). Kirim URL lengkap tanpa di-encode."
        },
        "customOrderId": {
          "type": "string",
          "required": false,
          "default": "Kenzie",
          "description": "ID order custom. Jika kosong, default 'Kenzie'."
        }
      },
      "example": {
        "curl": "curl -X POST \"https://am.noxxyrorr.biz.id/api/verify-link\" -H \"Content-Type: application/json\" -H \"Origin: https://am.noxxyrorr.biz.id\" -H \"Referer: https://am.noxxyrorr.biz.id/\" -d '{\"email\":\"akunwarnet62@gmail.com\",\"cookie\":\"SESSION=xxxxx\",\"magicLink\":\"https://alight-creative.firebaseapp.com/__/auth/links?...\",\"customOrderId\":\"Kenzie\"}'",
        "response": {
          "note": "CONTOH PERKIRAAN — format asli belum terverifikasi.",
          "ok": true,
          "email": "akunwarnet62@gmail.com",
          "status": "Active",
          "orderId": "Kenzie",
          "message": "Akun Alight Motion berhasil dipremiumkan!"
        }
      }
    }
  ],
  "errors": [
    {
      "when": "Header Origin/Referer tidak sesuai atau body bukan JSON",
      "expected": "HTTP 401/403 atau 400",
      "fix": "Pastikan Content-Type: application/json serta Origin/Referer menunjuk ke https://am.noxxyrorr.biz.id/."
    },
    {
      "when": "Field wajib kosong (email, cookie, magicLink)",
      "expected": "HTTP 400",
      "fix": "Isi semua field wajib pada body."
    },
    {
      "when": "Cookie sudah kedaluwarsa atau tidak cocok dengan email",
      "expected": "ok: false + pesan error",
      "fix": "Kirim ulang /send-link untuk mendapatkan cookie baru, lalu ulangi verifikasi."
    },
    {
      "when": "Link bukan dari email 'Sign in to Alight Creative' / sudah kedaluwarsa",
      "expected": "ok: false + pesan error",
      "fix": "Kirim ulang magic link lalu pakai link terbaru dari email 'Sign in'."
    },
    {
      "when": "Server API tidak merespons",
      "expected": "HTTP 5xx / timeout",
      "fix": "Coba lagi beberapa saat."
    }
  ],
  "usedInThisSite": {
    "description": "Script CLI interaktif memanggil langsung endpoint noxxyrorr via axios (Node.js). Tidak memakai proxy.",
    "endpoints": [
      {
        "method": "POST",
        "path": "/send-link",
        "body": { "email": "string" }
      },
      {
        "method": "POST",
        "path": "/verify-link",
        "body": {
          "email": "string",
          "cookie": "string",
          "magicLink": "string",
          "customOrderId": "string"
        }
      }
    ],
    "runtimeEnv": {
      "baseUrl": "https://am.noxxyrorr.biz.id/api",
      "defaultCustomOrderId": "Kenzie"
    }
  },
  "notes": [
    "Contoh respons ditandai 'PERKIRAAN' karena format asli API belum terverifikasi dari sisi server.",
    "Hanya link 'Sign in to Alight Creative' yang valid untuk /verify-link.",
    "Cookie dari /send-link wajib disimpan dan dipakai saat /verify-link.",
    "Gunakan email yang kamu miliki atau berhak kamu akses."
  ]
}
